    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: \"Trebuchet MS\", \"Gill Sans\", sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at top left, rgba(217, 119, 6, 0.18), transparent 32%),

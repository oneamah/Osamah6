{
   "servers": {
      "terraform-mcp-server": {
         "type": "stdio",
         "command": "docker",
         "args": [
            "run",
            "-i",
            "--rm",
            "-e",
            "TFE_TOKEN=${input:tfe_token}",
            "-e",
            "TFE_ADDRESS=${input:tfe_address}",
            "hashicorp/terraform-mcp-server:0.4.0"
         ]
      }
   },
   "inputs": [
      {
         "type": "promptString",
         "id": "tfe_token",
         "description": "HCP Terraform API token",
         "password": true
      },
      {
         "type": "promptString",
         "id": "tfe_address",
         "description": "HCP Terraform address, usually https://app.terraform.io",
         "password": false
      }
   ]
}